# 1. OpenAI Platform 관련 설정
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_OUTPUT_TOKENS=300
OPENAI_TIMEOUT_SECONDS=30

# 2. 가짜 LLM 관련 설정 (OpenAI API 키가 없거나 FAKE_LLM=true일 때 사용)
FAKE_LLM=false
FAKE_LLM_DELAY_SECONDS=3

# 3. [실험용] def 핸들러(동기)를 실행할 스레드 풀의 작업 스레드 수.
# THREAD_POOL_SIZE=1
